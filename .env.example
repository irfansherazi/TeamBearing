# ──────────────────────────────────────────────────────────────────
# vReview — Environment Variables Reference
# ──────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in ALL values before running:
#
#     Copy-Item .env.example .env    # Windows
#     cp .env.example .env           # macOS/Linux
#
# WARNING: The `.env` file contains secrets (API tokens, passwords).
#          NEVER commit it to version control.
#          .gitignore already excludes `.env`.
#
# In Docker, these variables are passed via docker-compose.yml.
# In production, use AWS SSM Parameter Store (see DEPLOYMENT.md §3).
# ──────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════
# SECRET LOADING STRATEGY
# ══════════════════════════════════════════════════════════════════
# By default, vQA loads secrets from AWS SSM Parameter Store first,
# then falls back to env vars / .env values.  start.ps1 / start.sh
# sources .env into the process before the backend starts.
#
# For local dev, set SKIP_SSM=1 to bypass SSM entirely and use
# only the values in this file.  AWS credentials are still needed
# for Bedrock (LLM) and S3 (artifact upload) — those use your
# AWS CLI profile, not SSM.

SKIP_SSM=1


# ══════════════════════════════════════════════════════════════════
# JIRA INTEGRATION
# ══════════════════════════════════════════════════════════════════
# When SKIP_SSM=0 (default), Jira creds are loaded from SSM:
#   /vQA/jira/email       — String    — Jira service account email
#   /vQA/jira/api_token   — SecureString — Jira API token
#   /vQA/jira/domain      — String    — e.g. vcreative.atlassian.net
#
# When SKIP_SSM=1, uncomment and fill in these values:
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_DOMAIN=vcreative.atlassian.net


# ══════════════════════════════════════════════════════════════════
# GITHUB INTEGRATION
# ══════════════════════════════════════════════════════════════════
# Used by the "Save as Test" workflow to commit recorded Playwright
# tests and open pull requests via the GitHub API.
# Generate a PAT at https://github.com/settings/tokens with
# repo scope (or Contents + Pull Requests for fine-grained).

GITHUB_TOKEN=
GITHUB_REPO=vcreativeinc/vReview

# Path to a vsuitePlatform checkout that has `npm run ai:review` (branch Syed/TD-260).
# Leave blank to use ../vsuitePlatform, or auto-create ../vsuitePlatform-ai-review.
VSUITE_PLATFORM_PATH=


# ══════════════════════════════════════════════════════════════════
# AWS CREDENTIALS
# ══════════════════════════════════════════════════════════════════
# Required for Bedrock (LLM) and S3 (artifact storage).
# If you have an AWS CLI profile configured (~/.aws/credentials),
# leave these BLANK — boto3 will use your profile automatically.
# Only set them explicitly for CI/CD or Docker environments.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Primary AWS region for S3 and general services
AWS_REGION=us-east-1

# Region where Bedrock is invoked (Claude 3.5 Sonnet)
# us-west-2 has direct model access; us-east-1 uses cross-region profiles
AWS_BEDROCK_REGION=us-west-2


# ══════════════════════════════════════════════════════════════════
# LLM / BEDROCK CONFIGURATION
# ══════════════════════════════════════════════════════════════════
# vQA uses Claude 3.5 Sonnet via AWS Bedrock for the multimodal
# see-think-act loop (screenshot + accessibility tree → JSON action).

# Provider identifier (only "bedrock" is supported currently)
LLM_PROVIDER=bedrock

# Bedrock model ID — use the cross-region inference profile (us.*) to avoid
# per-region end-of-life restrictions. Routes automatically across regions.
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock Knowledge Base ID for the vProMedia-Roles-KB
# Contains role permission matrices used by the planner and evaluator
# The History KB (RPORC9I3BU) and Code KB (Z2CRZIUUXL) are deprecated in vQA
BEDROCK_ROLES_KB_ID=JXMMTMTI06

# Data Source ID within the KB (required for make kb-human-sync).
# Find it in the AWS Bedrock console → Knowledge Bases → [your KB] → Data Sources.
# Format: a 10-char alphanumeric string, e.g. ABCDE12345
BEDROCK_KB_DATA_SOURCE_ID=


# ══════════════════════════════════════════════════════════════════
# S3 STORAGE
# ══════════════════════════════════════════════════════════════════
# All vQA artifacts (screenshots, videos, HTML reports) are uploaded
# to S3 under the prefix below.

# Target S3 bucket
S3_BUCKET=vcreative-deployments

# Key prefix within the bucket (no trailing slash)
# Sub-paths created automatically: /screenshots, /videos, /reports
S3_PREFIX=vSuitePlatform/Buildartif/vqa-results


# ══════════════════════════════════════════════════════════════════
# ROLE CREDENTIALS
# ══════════════════════════════════════════════════════════════════
# Login credentials for test automation roles.  Emails are fetched
# from the Bedrock Roles KB at startup (when SKIP_SSM=0); passwords
# are NOT in the KB and must always be set here.
#
# The shared password applies to ALL products (vProMedia, vPPO,
# vTrade, vPromotions) unless a product-specific override is set.
#
# Priority chain for passwords:
#   1. ROLE_DEFAULT_PASSWORD_VPPO  (vPPO roles only)
#   2. ROLE_DEFAULT_PASSWORD       (all products)
#   3. Hardcoded fallback in code  (Ep!cVCteam2026$)
#
# Current KB email coverage (as of last test):
#   OK  account_executive   → imail-test+DemoAE@vcreativeinc.com
#   GAP sales_manager       → NOT IN KB — set ROLE_EMAIL_SALES_MANAGER
#   OK  sales_assistant     → cyndi.bass82@yahoo.com
#   OK  production_manager  → imail-test+DemoProdMan@vcreativeinc.com
#   OK  producer            → imail-test+DemoTVProducer@vcreativeinc.com
#   OK  gm_gsm              → imail-test+DemoGM@vcreativeinc.com
#   OK  dubber              → imail-test+DemoProdDirector@vcreativeinc.com
#   OK  digital_director    → imail-test+DemoDigitalDir@vcreativeinc.com
#
# vPPO role emails are hardcoded in backend/engine/roles.py and do
# not come from the KB.  See knowledge/personas/vppo/ for details.

# Shared password for all test accounts (all products)
ROLE_DEFAULT_PASSWORD=Ep!cVCteam2026$

# vPPO-specific password override (optional — falls back to ROLE_DEFAULT_PASSWORD)
# Set this only if vPPO test accounts use a different password than vProMedia.
# ROLE_DEFAULT_PASSWORD_VPPO=

# Only sales_manager has a KB content gap — set this as fallback:
# ROLE_EMAIL_SALES_MANAGER=

# Sales Executive — needed for multi-persona AC steps 6-9 (FEAT-103 / QA-103)
# Example: imail-test+DemoSalesExec@vcreativeinc.com
# ROLE_EMAIL_SALES_EXEC=

# The remaining role emails below are only needed if running without KB access:
# ROLE_EMAIL_AE=
# ROLE_EMAIL_SALES_ASSISTANT=
# ROLE_EMAIL_PRODUCTION_MANAGER=
# ROLE_EMAIL_PRODUCER=
# ROLE_EMAIL_GM_GSM=
# ROLE_EMAIL_DUBBER=
# ROLE_EMAIL_DIGITAL_DIRECTOR=


# ══════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ══════════════════════════════════════════════════════════════════

# Execution mode:
#   "headless" — pure headless Playwright (VQA_SLOW_MO=0, no browser window)
#   "interactive" — alias for headless kept for backwards compat
# The headed mode is now the default when VQA_SLOW_MO > 0.
VQA_MODE=interactive

# Browser visibility mode (TASK-031 / FEAT-043):
#
#   VQA_HEADLESS=0  — HEADFUL (default): Chromium opens a visible window.
#                     Use this in local development and QA demos where the
#                     operator watches the automation live on-screen.
#                     The browser window appears within 1 second of run start.
#
#   VQA_HEADLESS=1  — HEADLESS: Chromium runs without a display (no window).
#                     Use this in CI/CD pipelines (GitHub Actions, ECS tasks)
#                     where no desktop environment is available.
#                     Also enforced automatically by VQA_MODE=headless.
#
# NOTE: Headful mode (VQA_HEADLESS=0) requires a desktop display. On Linux
# servers without a GUI, use VQA_HEADLESS=1 or wrap the process with Xvfb.
# In Docker deployments (ECS/EC2), always set VQA_HEADLESS=1.
# See DEPLOYMENT.md § Headful Mode for full setup instructions.
VQA_HEADLESS=0

# slowMo delay (ms) injected between every Playwright action.
# 500ms (default) lets Angular/PrimeNG change-detection settle in headed mode.
# Set to 0 for headless CI runs (no visible browser, no waiting).
VQA_SLOW_MO=500

# Default URL of the application under test
# Can be overridden per-request in the /execute API payload
TARGET_URL=https://two-test.vcreative.net

# Maximum self-heal retries per Acceptance Criteria step (1-10)
MAX_RETRIES=3

# Maximum iterations of the see-think-act loop before aborting (5-200)
# Safety cap to prevent infinite loops on unsatisfiable AC steps
MAX_PLANNER_ITERATIONS=50

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port for the noVNC WebSocket proxy (interactive mode only)
NOVNC_PORT=6080

# Port for the FastAPI / uvicorn server
API_PORT=8000

# Minimum similarity threshold for KB RAG retrieval (e.g. 0.2)
# Matches scoring below this threshold are discarded.
KB_MIN_SIMILARITY_SCORE=0.2


# ══════════════════════════════════════════════════════════════════
# TEST PERSISTENCE & SMART REPLAY (TASK-031 / FEAT-043)
# ══════════════════════════════════════════════════════════════════
# When an operator "accepts" a vQA run result, the approved action
# sequence is stored on disk so future runs for the same ticket can
# replay it deterministically — skipping the LLM planner entirely.
#
# Smart Replay reduces cost and latency for known-passing flows by
# ≥ 70%% (no Bedrock calls, no screenshot analysis).

# Filesystem directory for accepted test records (relative to vQA root).
# The directory is created automatically if it does not exist.
# Index file: <ACCEPTED_TESTS_DIR>/index.json
# Records:    <ACCEPTED_TESTS_DIR>/<ticket_id>-<ac_hash>.json
ACCEPTED_TESTS_DIR=memory/accepted_tests

# Enable Smart Replay (default: true).
# Set to false to always run full AI-driven execution, even when an
# accepted test is available.  Useful for debugging or re-recording.
ENABLE_SMART_REPLAY=true


# ══════════════════════════════════════════════════════════════════
# PLAYWRIGHT STANDARD LIBRARY (TASK-060 / FEAT-052)
# ══════════════════════════════════════════════════════════════════
# Wires the production playwright/ directory into the vQA product.
# All 40+ tests in playwright/tests/ are accessible from the Playwright
# Dashboard at /playwright. Auth sessions are managed per-user per-env.

# Directory containing Playwright test files (.test.ts)
PLAYWRIGHT_TESTS_DIR=playwright/tests

# Path to the canonical test index (pre-generated by scripts/sync_playwright_index.py)
PLAYWRIGHT_INDEX_FILE=playwright/playwright_index.json

# Shared password for all demo test accounts (used by generateStorageStates.mjs)
# REQUIRED for POST /playwright/storage/generate to work
SHARED_TEST_PASSWORD=Ep!cVCteam2026$

# Admin password for doc+test_admin@vcreativeinc.com
# REQUIRED for Admin user storage state generation
ADMIN_TEST_PASSWORD=Ep!cVCteam2026$

# Target environment for Playwright runs: prod, test, smoke, qa
# Used as the default TEST_ENV when no env is specified in the API request
TEST_ENV=test
