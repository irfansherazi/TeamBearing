{
  "family": "vqa-frontend",
  "taskRoleArn": "arn:aws:iam::404940539857:role/VQAEcsTaskRole",
  "executionRoleArn": "arn:aws:iam::404940539857:role/VQAEcsExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "vqa-frontend",
      "image": "404940539857.dkr.ecr.us-east-1.amazonaws.com/vqa-frontend:latest",
      "portMappings": [
        { "containerPort": 80, "hostPort": 80, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vqa-frontend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
